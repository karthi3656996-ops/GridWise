# ═══════════════════════════════════════════════════════════════════════
# GRIDWISE ENERGY OS — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════

# Node Server Port
PORT=3000

# PostgreSQL Connection Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=gridwise_db
PGUSER=postgres
PGPASSWORD=your_postgres_password_here
PGSSL=false
PGPOOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=2000

# Security & JSON Web Tokens
JWT_SECRET=gridwise_energy_os_secure_jwt_token_key_2026_super_secret_string
JWT_EXPIRES_IN=4h

# Upstream Live Indian Grid API
UPSTREAM_API_BASE=https://india-energy-data.vercel.app/api/v1
INDIA_CACHE_TTL_MS=300000
